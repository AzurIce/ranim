{% extends "layouts/base" %}
{% block body %}
  <div class="container content">
    <div style="flex-grow: 1; display: flex; flex-direction: column; align-items: center; margin: 2rem auto">
      <img src="{{url(path='ranim.svg')}}" width="200" alt="Ranim logo">
      <article class="markdown-body">
        {{page.html | safe}}
        {% set example = site.data[page.attrs.example] %}
        {% include "components/player" %}
      </article>
    </div>
  </div>
{% endblock body %}
