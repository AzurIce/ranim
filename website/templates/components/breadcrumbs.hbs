<nav class="breadcrumbs" aria-label="Breadcrumb">
  <a href="{{url '/'}}">Ranim</a>
  {{#each page.ancestors}}
    {{#if this}}{{#with (lookup @root.site.directories this)}}{{#if index}}
      <span class="breadcrumbs__sep">/</span><a href="{{url index.route.url}}">{{index.title}}</a>
    {{/if}}{{/with}}{{/if}}
  {{/each}}
  {{#unless (eq page.route.output 'index.html')}}<span class="breadcrumbs__sep">/</span><span class="breadcrumbs__current">{{page.title}}</span>{{/unless}}
</nav>
